      "writes": true
    },
    {
      "name": "format:check",
      "command": "prettier --check --ignore-unknown --no-error-on-unmatched-pattern \"*.{js,mjs,cjs,ts,mts,cts,json,md,yml,yaml}\" \"wp-content/plugins/example/**/*\" \"wp-content/themes/example/**/*\"",
      "writes": false
    },
    {
      "name": "format",
      "command": "prettier --write --ignore-unknown --no-error-on-unmatched-pattern \"*.{js,mjs,cjs,ts,mts,cts,json,md,yml,yaml}\" \"wp-content/plugins/example/**/*\" \"wp-content/themes/example/**/*\"",
      "writes": true
    }
  ],
  "hooks": [
    {
      "hook": "pre-commit",
      "name": "prettier",
      "run": "npx --no -- prettier --check --ignore-unknown --no-error-on-unmatched-pattern {staged_files}"
    },
    {
      "hook": "pre-commit",
      "name": "markdownlint",
      "run": "npx --no -- markdownlint-cli2 {staged_files}"
    },
    {
      "hook": "pre-commit",
      "name": "eslint",
      "run": "npx --no -- eslint --cache --cache-location .cache/eslint/ --no-warn-ignored {staged_files}"
    },
    {
      "hook": "pre-commit",
      "name": "stylelint",
      "run": "npx --no -- stylelint --allow-empty-input {staged_files}"
    },
    {
      "hook": "pre-commit",
      "name": "php-lint",
      "run": "node .configra/scripts/php-lint.mjs {staged_files}"
    },
    {
      "hook": "pre-commit",
      "name": "phpcs",
      "run": "node .configra/scripts/php-tool.mjs phpcs {staged_files}"
    },
    {
      "hook": "pre-push",
      "name": "phpstan",
      "run": "node .configra/scripts/php-tool.mjs phpstan analyse --memory-limit=1G --no-progress"
    },
    {
      "hook": "commit-msg",
      "name": "commit-message",
      "run": "node .configra/scripts/commit-msg.mjs --mode plain {1}"
    }
  ],
  "commands": [
    {
      "phase": "install",
