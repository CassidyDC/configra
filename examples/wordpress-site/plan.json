      "command": "node .configra/scripts/php-tool.mjs phpstan analyse --memory-limit=1G --no-progress",
      "writes": false
    },
    {
      "name": "lint",
      "command": "npm run lint:md && npm run lint:js && npm run lint:css && npm run lint:php-syntax && npm run lint:phpcs && npm run lint:phpstan",
      "writes": false
    },
    {
      "name": "lint:fix",
