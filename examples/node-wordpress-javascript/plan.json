  "conflicts": [],
  "dependencies": {
    "npm": {
      "add": {
        "prettier": "^3.10.1",
        "@wordpress/prettier-config": "^5.2.0",
        "markdownlint-cli2": "^0.24.2",
        "eslint": "^10.15.0",
        "@wordpress/eslint-plugin": "^28.2.0",
        "lefthook": "^2.2.2"
      },
      "remove": []
    },
    "composer": {
      "add": {},
      "remove": []
    }
  },
  "scripts": [
    {
      "name": "lint:md",
      "command": "markdownlint-cli2 \"**/*.md\"",
      "writes": false
    },
    {
      "name": "lint:js",
      "command": "eslint --cache --cache-location .cache/eslint/ --no-error-on-unmatched-pattern .",
      "writes": false
    },
    {
      "name": "lint",
      "command": "npm run lint:md && npm run lint:js",
      "writes": false
    },
    {
      "name": "lint:fix",
      "command": "markdownlint-cli2 --fix \"**/*.md\" && eslint --cache --cache-location .cache/eslint/ --no-error-on-unmatched-pattern --fix .",
      "writes": true
    },
    {
      "name": "format:check",
      "command": "prettier --check --no-error-on-unmatched-pattern .",
      "writes": false
    },
    {
      "name": "format",
      "command": "prettier --write --no-error-on-unmatched-pattern .",
      "writes": true
    }
  ],
  "hooks": [
    {
      "hook": "pre-commit",
      "name": "prettier",
      "run": "npx --no -- prettier --check --ignore-unknown --no-error-on-unmatched-pattern {staged_files}"
    },
    {
      "hook": "pre-commit",
      "name": "markdownlint",
      "run": "npx --no -- markdownlint-cli2 {staged_files}"
    },
    {
      "hook": "pre-commit",
      "name": "eslint",
      "run": "npx --no -- eslint --cache --cache-location .cache/eslint/ --no-warn-ignored {staged_files}"
    },
    {
      "hook": "commit-msg",
      "name": "commit-message",
      "run": "node .configra/scripts/commit-msg.js --mode plain {1}"
    }
  ],
  "commands": [
    {
      "phase": "install",
      "manager": "npm",
      "executable": "npm",
      "args": [
        "install",
        "--ignore-scripts",
        "--no-audit",
        "--no-fund"
      ],
      "cwd": ".",
      "approved": false
    },
    {
      "phase": "activate-hooks",
      "executable": "npx",
      "args": [
        "--no",
        "--",
        "lefthook",
        "install"
      ],
      "cwd": ".",
      "approved": false
    }
  ],
  "diagnostics": [],
  "selections": {
    "version": 1,
    "project": "node",
    "languages": [
      "javascript"
    ],
    "ui": [],
    "standards": {
      "javascript": "wordpress"
    },
    "tools": [
      "editorconfig",
      "gitignore",
      "prettier",
      "markdownlint",
      "eslint",
      "lefthook"
    ],
    "commitMessages": "plain"
  }
}
