{
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.15"
	},
	"scripts": {
		"lint:md": "markdownlint-cli2 \"**/*.md\"",
		"lint:js": "eslint --cache --cache-location .cache/eslint/ --no-error-on-unmatched-pattern .",
		"lint": "npm run lint:md && npm run lint:js",
		"lint:fix": "markdownlint-cli2 --fix \"**/*.md\" && eslint --cache --cache-location .cache/eslint/ --no-error-on-unmatched-pattern --fix .",
		"format:check": "prettier --check --no-error-on-unmatched-pattern .",
		"format": "prettier --write --no-error-on-unmatched-pattern ."
	},
	"devDependencies": {
		"@wordpress/eslint-plugin": "^28.2.0",
		"@wordpress/prettier-config": "^5.2.0",
		"eslint": "^10.15.0",
		"lefthook": "^2.2.2",
		"markdownlint-cli2": "^0.24.2",
		"prettier": "^3.10.1"
	}
}
