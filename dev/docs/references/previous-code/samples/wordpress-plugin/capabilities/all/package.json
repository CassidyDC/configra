{
	"name": "sample-root",
	"private": true,
	"scripts": {
		"lint:js": "eslint .",
		"lint:markdown": "markdownlint-cli2 \"**/*.md\"",
		"lint:php:syntax": "vendor/bin/parallel-lint --exclude 'node_modules' --exclude 'vendor' --exclude '.git' --exclude 'dist' --exclude 'build' --exclude '.phpstan-cache' .",
		"lint:php:style": "vendor/bin/phpcs",
		"lint:php:types": "vendor/bin/phpstan analyse --no-progress",
		"format:check": "prettier . --check",
		"format": "prettier . --write",
		"lint:css": "stylelint \"**/*.css\" --allow-empty-input",
		"hooks:install": "lefthook install",
		"lint:local": "npm run format:check && npm run lint:css && npm run lint:js && npm run lint:markdown && npm run lint:php:style && npm run lint:php:syntax && npm run lint:php:types",
		"lint": "npm run lint:local"
	},
	"devDependencies": {
		"eslint": "^10.0.0",
		"globals": "^17.0.0",
		"@wordpress/eslint-plugin": "^27.1.0",
		"typescript-eslint": "^8.0.0",
		"typescript": "^5.0.0",
		"eslint-config-prettier": "^10.0.0",
		"markdownlint-cli2": "^0.23.0",
		"prettier": "^3.0.0",
		"@wordpress/prettier-config": "^4.0.0",
		"stylelint-scss": "^7.2.0",
		"stylelint": "^17.14.1",
		"@wordpress/stylelint-config": "^26.1.0",
		"lefthook": "^2.2.0"
	}
}
