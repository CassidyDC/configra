includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
parameters:
    level: 5
    paths:
        - .
    tmpDir: .phpstan-cache
    excludePaths:
        analyseAndScan:
            - "*/node_modules/*"
            - "*/vendor/*"
            - "*/.git/*"
            - "*/dist/*"
            - "*/build/*"
            - "*/.phpstan-cache/*"
