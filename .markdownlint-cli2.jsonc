// Markdownlint Configuration
// Repository Markdown lint rules and exclusions.

{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "default": true,
    "heading-style": {
      "style": "atx"
    },
    "line-length": false,
    "no-duplicate-heading": {
      "siblings_only": true
    },
    "no-hard-tabs": false,
    "no-trailing-punctuation": false,
    "ol-prefix": {
      "style": "ordered"
    },
    "whitespace": false
  },
  "ignores": [
    "node_modules",
    "dist",
    "dev/docs/references/previous-code"
  ],
  "gitignore": true
}
