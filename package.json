{
  "name": "@cassidydc/configra",
  "displayName": "Configra",
  "version": "1.0.0",
  "description": "Configurable code formatting, linting, and scripting for development projects.",
  "author": {
    "name": "CassidyDC",
    "email": "hello@cassidydc.com",
    "url": "https://cassidydc.com"
  },
  "bin": {
    "configra": "./bin/configra.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "type": "module",
  "homepage": "https://github.com/CassidyDC/configra/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/CassidyDC/configra"
  },
  "bugs": {
    "url": "https://github.com/CassidyDC/configra/issues"
  },
  "license": "MIT",
  "keywords": [
    "eslint",
    "formatter",
    "linter",
    "prettier",
    "stylelint",
    "wordpress"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "lefthook": "^2.2.1",
    "markdownlint-cli2": "^0.23.3",
    "prettier-plugin-multiline-arrays": "^4.1.11",
    "js-yaml": "^5.4.1"
  },
  "scripts": {
    "check": "npx prettier . --check",
    "format": "npx prettier . --write",
    "hook:install": "npx lefthook install",
    "lint:docs": "npx markdownlint-cli2 \"**/*.md\"",
    "lint:docs:fix": "npx markdownlint-cli2 \"**/*.md\" --fix",
    "lint:scripts": "npx eslint",
    "lint:scripts:fix": "npx eslint --fix",
    "samples:generate": "node scripts/generate-samples.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "prettier": "^3.9.10"
  }
}
