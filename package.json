{
  "name": "@cassidydc/configra",
  "displayName": "Configra",
  "version": "0.0.0",
  "description": "Generate editable linting, formatting, and Git hook configuration for Node.js and WordPress projects.",
  "author": {
    "name": "CassidyDC",
    "email": "hello@cassidydc.com",
    "url": "https://cassidydc.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/CassidyDC/configra#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CassidyDC/configra.git"
  },
  "bugs": {
    "url": "https://github.com/CassidyDC/configra/issues"
  },
  "keywords": [
    "cli",
    "editorconfig",
    "eslint",
    "formatter",
    "lefthook",
    "linter",
    "markdownlint",
    "php_codesniffer",
    "phpstan",
    "prettier",
    "stylelint",
    "wordpress"
  ],
  "type": "module",
  "bin": {
    "configra": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24.15"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node dev/scripts/build.ts",
    "examples:update": "node dev/scripts/update-examples.ts",
    "format": "prettier --write --no-error-on-unmatched-pattern .",
    "format:check": "prettier --check --no-error-on-unmatched-pattern .",
    "generate:ranges": "node dev/scripts/generate-dependency-ranges.ts",
    "hooks:install": "lefthook install",
    "lint": "npm run lint:md && npm run lint:js",
    "lint:fix": "markdownlint-cli2 --fix \"**/*.md\" && eslint --cache --cache-location .cache/eslint/ --no-error-on-unmatched-pattern --fix .",
    "lint:js": "eslint --cache --cache-location .cache/eslint/ --no-error-on-unmatched-pattern .",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "test": "vitest run --project offline",
    "test:consumer": "vitest run --project consumer",
    "test:smoke": "vitest run --project smoke",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.19.2",
    "@types/semver": "^7.8.0",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "globals": "^17.14.0",
    "lefthook": "^2.2.2",
    "markdownlint-cli2": "^0.24.2",
    "prettier": "^3.10.1",
    "prettier-plugin-multiline-arrays": "^4.1.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "semver": "^7.8.6",
    "typebox": "^1.4.7"
  }
}
